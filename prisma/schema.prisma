// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  APPROVER
  FINANCE
  ADMIN
  SUPER_ADMIN
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CHANGE_REQUESTED
  PAID
}

enum Category {
  TRAVEL
  MEALS
  SUPPLIES
  ACCOMMODATION
  COMMUNICATION
  TRAINING
  ENTERTAINMENT
  MEETING
  EQUIPMENT
  PRINTING
  SOFTWARE
  OTHER
}

enum ApprovalStepStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGE_REQUESTED
}

enum ChangeRequestStatus {
  OPEN
  RESOLVED
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  IN_APP
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

// ---------------------------------------------------------------------------
// Leave & Calendar module enums
// ---------------------------------------------------------------------------

enum CalendarProvider {
  NONE
  GOOGLE
  LARK
  OUTLOOK
  APPLE_ICS
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  NEGOTIATING
}

enum ProposalStatus {
  PENDING
  AGREED
  DISAGREED
  SUPERSEDED
  EXPIRED
}

enum ProposerRole {
  SUPERVISOR
  EMPLOYEE
}

enum OvertimeDayType {
  WEEKDAY
  WEEKEND
  PUBLIC_HOLIDAY
}

enum OvertimeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WorkLocationType {
  OFFICE
  WFH
  WFS
}

enum PerDiemStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveEmailType {
  REQUEST_SUBMITTED
  APPROVED
  REJECTED
  SUPERVISOR_PROPOSAL
  EMPLOYEE_COUNTER
  PROPOSAL_AGREED
  PROPOSAL_DISAGREED
  REMINDER_PENDING
  REMINDER_LEAVE
  TOKEN_EXPIRED
  OVERTIME_REQUEST
  OVERTIME_APPROVED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  industry  String?
  logoUrl   String?
  baseCurrency String @default("IDR")
  countryCode String @default("ID")        // ISO-3166-1 alpha-2; drives default holidays
  createdAt DateTime @default(now())
  users     User[]
  invitations UserInvitation[]
  configs   AdminConfig[]
  leaveTypes      LeaveType[]
  leaveRequests   LeaveRequest[]
  publicHolidays  PublicHoliday[]
  overtimeRecords OvertimeRecord[]
  workLocationLogs WorkLocationLog[]
  leaveBalanceAdjustments LeaveBalanceAdjustment[]
  companyEvents   CompanyEvent[]
  perDiemRequests PerDiemRequest[]
  countryPayrollRules CountryPayrollRule[]
  employeeCompensations EmployeeCompensation[]
  payrollAdjustments PayrollAdjustment[]
  payslips Payslip[]
  costCenters CostCenter[]
}

// Regional cost center inside an Organization (e.g. "Indonesia HQ",
// "Vietnam Office"). Drives per-user reimbursement currency and — once
// the routing pass lands — scopes which Approver / Finance users see
// which requests. The org base currency remains the global reporting
// fallback for users with no cost center assigned.
model CostCenter {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Short stable handle (e.g. "ID-HQ", "VN-HCM"). Unique per org.
  code           String
  name           String
  // ISO-3166-1 alpha-2 — drives default rules / public holidays scoping
  // when the per-CC payroll rules land. Defaults to org's countryCode.
  countryCode    String
  // ISO-4217 — every reimbursement raised by a user assigned to this CC
  // converts to this currency, regardless of receipt currency.
  currency       String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  users          User[]   @relation("UserCostCenter")
  invitations    UserInvitation[] @relation("InvitationCostCenter")
  payrollRules   CountryPayrollRule[] @relation("CostCenterPayrollRules")
  compensations  EmployeeCompensation[] @relation("CostCenterCompensations")
  payslips       Payslip[] @relation("CostCenterPayslips")
  adminConfigs   AdminConfig[] @relation("AdminConfigCostCenter")

  @@unique([organizationId, code])
  @@index([organizationId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(EMPLOYEE)
  department    String?
  managerId     String?
  createdAt     DateTime  @default(now())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  // Regional assignment. Drives the reimbursement payout currency
  // (overrides Organization.baseCurrency). Nullable for back-compat —
  // unassigned users fall through to org base.
  costCenterId  String?
  costCenter    CostCenter? @relation("UserCostCenter", fields: [costCenterId], references: [id], onDelete: SetNull)
  status        UserStatus @default(PENDING)
  phone         String?
  emailAliases  Json?      // Array<{ type: 'work' | 'personal', email: string }>
  nationalIdUrl String?
  selfieUrl     String?
  kycVerified   Boolean    @default(false)
  notificationPrefs Json?
  invitations   UserInvitation[] @relation("InvitedBy")

  manager              User?                  @relation("ManagerSubordinates", fields: [managerId], references: [id])
  subordinates         User[]                 @relation("ManagerSubordinates")
  accounts             Account[]
  sessions             Session[]
  requests             ReimbursementRequest[] @relation("EmployeeRequests")
  approvalSteps        ApprovalStep[]
  changeRequestsRaised ChangeRequest[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  monthlyReports       MonthlyReport[]
  configUpdates        AdminConfig[]
  // Leave & calendar relations
  profile              UserProfile?
  calendarTokens       CalendarToken[]
  leaveRequests        LeaveRequest[]   @relation("EmployeeLeave")
  supervisedLeaves     LeaveRequest[]   @relation("SupervisorLeave")
  perDiemRequests      PerDiemRequest[] @relation("EmployeePerDiem")
  supervisedPerDiems   PerDiemRequest[] @relation("SupervisorPerDiem")
  compensation         EmployeeCompensation?
  payrollAdjustments   PayrollAdjustment[]
  payslips             Payslip[]
  leaveProposals       LeaveProposal[]
  overtimeRecords      OvertimeRecord[] @relation("EmployeeOT")
  supervisedOvertime   OvertimeRecord[] @relation("SupervisorOT")
  workLocationLogs     WorkLocationLog[]
  leaveBalanceAdjustments     LeaveBalanceAdjustment[] @relation("EmployeeAdj")
  leaveBalanceAdjustmentsMade LeaveBalanceAdjustment[] @relation("AdjGrantedBy")
}

model ReimbursementRequest {
  id          String        @id @default(cuid())
  employeeId  String
  title       String
  description String?       @db.Text
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("IDR")
  amountIDR   Decimal?      @db.Decimal(15, 2) // converted amount in Indonesian Rupiah
  exchangeRate Decimal?     @db.Decimal(15, 6) // FX rate used: 1 unit of currency = X IDR
  category    Category
  receiptUrl  String?
  receiptRaw  String?       @db.Text
  parsedData  Json?
  status      RequestStatus @default(DRAFT)
  submittedAt DateTime?
  month       String? // YYYY-MM
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  employee       User           @relation("EmployeeRequests", fields: [employeeId], references: [id])
  approvalSteps  ApprovalStep[]
  changeRequests ChangeRequest[]
  notifications  Notification[]
  auditLogs      AuditLog[]
}

model ApprovalStep {
  id         String             @id @default(cuid())
  requestId  String
  approverId String
  order      Int
  status     ApprovalStepStatus @default(PENDING)
  comment    String?            @db.Text
  decidedAt  DateTime?
  createdAt  DateTime           @default(now())

  request  ReimbursementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver User                 @relation(fields: [approverId], references: [id])
}

model ChangeRequest {
  id          String              @id @default(cuid())
  requestId   String
  raisedById  String
  raisedByRole Role
  message     String              @db.Text
  status      ChangeRequestStatus @default(OPEN)
  resolvedAt  DateTime?
  createdAt   DateTime            @default(now())

  request   ReimbursementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  raisedBy  User                 @relation(fields: [raisedById], references: [id])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  requestId String?
  type      String
  message   String              @db.Text
  read      Boolean             @default(false)
  channel   NotificationChannel @default(IN_APP)
  sentAt    DateTime            @default(now())

  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  request ReimbursementRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id        String   @id @default(cuid())
  requestId String?
  actorId   String
  action    String
  details   Json?
  createdAt DateTime @default(now())

  request ReimbursementRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  actor   User                  @relation(fields: [actorId], references: [id])
}

model AdminConfig {
  id             String   @id @default(cuid())
  key            String
  value          Json
  organizationId String?
  // Optional cost-center scope. null = org-wide setting (the legacy
  // behaviour). When a CC-specific row exists for the same (key, org),
  // it overrides the org-wide one for users in that CC. Resolved via
  // getConfig(prisma, key, orgId, costCenterId?).
  costCenterId   String?
  updatedAt      DateTime @updatedAt
  updatedById    String?

  updatedBy    User?         @relation(fields: [updatedById], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costCenter   CostCenter?   @relation("AdminConfigCostCenter", fields: [costCenterId], references: [id], onDelete: Cascade)

  @@unique([key, organizationId, costCenterId], map: "AdminConfig_key_org_cc_key")
  @@index([key, organizationId])
}

model MonthlyReport {
  id            String   @id @default(cuid())
  month         String   @unique // YYYY-MM
  generatedById String
  sheetUrl      String?
  generatedAt   DateTime @default(now())

  generatedBy User @relation(fields: [generatedById], references: [id])
}

model UserInvitation {
  id          String       @id @default(cuid())
  email       String
  phone       String?
  role        Role         @default(EMPLOYEE)
  orgId       String?
  costCenterId String?
  token       String       @unique @default(cuid())
  otp         String?
  otpExpiresAt DateTime?
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime
  sentAt      DateTime     @default(now())
  acceptedAt  DateTime?
  invitedById String
  invitedBy   User         @relation("InvitedBy", fields: [invitedById], references: [id])
  organization Organization? @relation(fields: [orgId], references: [id])
  costCenter   CostCenter?  @relation("InvitationCostCenter", fields: [costCenterId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// User profile & onboarding
// ---------------------------------------------------------------------------

model UserProfile {
  id                  String           @id @default(cuid())
  userId              String           @unique
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  isOnboarded         Boolean          @default(false)
  countryCode         String           @default("ID")
  timezone            String           @default("Asia/Jakarta")
  defaultCurrency     String           @default("IDR")
  dateFormat          String           @default("DD/MM/YYYY")
  weekStartsOn        Int              @default(1)
  jobTitle            String?
  employmentStartDate DateTime?
  employmentEndDate   DateTime?
  phone               String?
  photoUrl            String?
  calendarProvider    CalendarProvider @default(NONE)
  emailActionsEnabled Boolean          @default(true)
  notifyOnLeaveStatus Boolean          @default(true)
  notifyOnProposal    Boolean          @default(true)
  notifyBeforeLeave   String?          @default("1d")
  notifyInApp         Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model CalendarToken {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       CalendarProvider
  accountEmail   String?
  encryptedToken String           @db.Text
  tokenExpiry    DateTime?
  connectedAt    DateTime         @default(now())
  lastSyncedAt   DateTime?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, provider])
}

// ---------------------------------------------------------------------------
// Leave management
// ---------------------------------------------------------------------------

model LeaveType {
  id               String   @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code             String   // SICK | PERSONAL | FAMILY | ANNUAL | MATERNITY | PATERNITY | BEREAVEMENT | COMPENSATORY
  name             String
  description      String?
  colorHex         String   @default("#3B82F6")
  maxDaysPerYear   Int?
  requiresApproval Boolean  @default(true)
  isPaid           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  requests         LeaveRequest[]
  adjustments      LeaveBalanceAdjustment[]

  @@unique([organizationId, code])
}

model LeaveRequest {
  id                   String              @id @default(cuid())
  organizationId       String
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId           String
  employee             User                @relation("EmployeeLeave", fields: [employeeId], references: [id])
  supervisorId         String
  supervisor           User                @relation("SupervisorLeave", fields: [supervisorId], references: [id])
  leaveTypeId          String
  leaveType            LeaveType           @relation(fields: [leaveTypeId], references: [id])
  startDate            DateTime
  endDate              DateTime
  totalDays            Float
  isHalfDay            Boolean             @default(false)
  halfDayPeriod        String?             // "AM" | "PM"
  reason               String?             @db.Text
  status               LeaveStatus         @default(PENDING)
  supervisorNote       String?             @db.Text
  adminNote            String?             @db.Text
  rejectionReason      String?             @db.Text
  calEventEmployeeId   String?
  calEventSupervisorId String?
  approveToken         String?             @unique
  rejectToken          String?             @unique
  tokenExpiresAt       DateTime?
  negotiationRound     Int                 @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  proposals            LeaveProposal[]
  emailEvents          LeaveEmailEvent[]

  @@index([organizationId, status])
  @@index([employeeId, status])
  @@index([supervisorId, status])
}

model LeaveProposal {
  id              String           @id @default(cuid())
  leaveRequestId  String
  leaveRequest    LeaveRequest     @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  proposedById    String
  proposedBy      User             @relation(fields: [proposedById], references: [id])
  proposerRole    ProposerRole
  proposedStart   DateTime
  proposedEnd     DateTime
  proposedDays    Float
  message         String           @db.Text
  status          ProposalStatus   @default(PENDING)
  responseNote    String?          @db.Text
  agreeToken      String?          @unique
  disagreeToken   String?          @unique
  tokenExpiresAt  DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([leaveRequestId, status])
}

model LeaveEmailEvent {
  id             String         @id @default(cuid())
  leaveRequestId String
  leaveRequest   LeaveRequest   @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  toEmail        String
  toUserId       String?
  emailType      LeaveEmailType
  subject        String
  sentAt         DateTime       @default(now())
  tokenUsedAt    DateTime?
  actionTaken    String?        // "APPROVED" | "REJECTED" | "AGREED" | "DISAGREED" | "EXPIRED" | "SUPERSEDED"

  @@index([leaveRequestId, sentAt])
}

model PublicHoliday {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  date           DateTime
  countryCode    String
  isRecurring    Boolean  @default(true)
  type           String   @default("NATIONAL")
  createdAt      DateTime @default(now())

  @@unique([organizationId, date, countryCode, name])
  @@index([organizationId, date])
}

model OvertimeRecord {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       User            @relation("EmployeeOT", fields: [employeeId], references: [id])
  supervisorId   String
  supervisor     User            @relation("SupervisorOT", fields: [supervisorId], references: [id])
  date           DateTime
  hoursWorked    Float
  dayType        OvertimeDayType
  multiplier     Float
  lieuDaysEarned Float
  lieuExpiresAt  DateTime?
  calEventId     String?
  notes          String?         @db.Text
  status         OvertimeStatus  @default(PENDING)
  approveToken   String?         @unique
  rejectToken    String?         @unique
  tokenExpiresAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId, status])
  @@index([employeeId, date])
}

// Manual per-employee, per-leave-type, per-year balance adjustment.
// Positive `days` = extra allowance (e.g. mid-year hire prorated grant);
// negative = clawback. Summed in /api/leave/balance/[userId].
model LeaveBalanceAdjustment {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       User     @relation("EmployeeAdj", fields: [employeeId], references: [id])
  leaveTypeId    String
  leaveType      LeaveType @relation(fields: [leaveTypeId], references: [id])
  year           Int
  days           Float
  reason         String   @db.Text
  grantedById    String
  grantedBy      User     @relation("AdjGrantedBy", fields: [grantedById], references: [id])
  createdAt      DateTime @default(now())

  @@index([organizationId, employeeId, year])
  @@index([leaveTypeId, year])
}

// Org-scoped company / special events surfaced on the employee calendar.
// All-day or timed; can span multiple days. Admins CRUD via the admin
// console; everyone in the org can read.
model CompanyEvent {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  description    String?  @db.Text
  startDate      DateTime
  endDate        DateTime
  allDay         Boolean  @default(true)
  category       String   @default("COMPANY")  // COMPANY | SPECIAL | TRAINING | OTHER
  colorHex       String   @default("#22D3EE")
  location       String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, startDate])
}

model WorkLocationLog {
  id              String           @id @default(cuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        User             @relation(fields: [employeeId], references: [id])
  date            DateTime
  locationType    WorkLocationType
  locationName    String?
  locationAddress String?
  contactPhone    String?
  contactEmail    String?
  notes           String?          @db.Text
  calEventId      String?
  createdAt       DateTime         @default(now())

  @@index([organizationId, date])
  @@index([employeeId, date])
}

// ---------------------------------------------------------------------------
// Business Per Diem
// ---------------------------------------------------------------------------

// One claim per trip; rates and per-day breakdown are frozen at submission
// so subsequent admin changes to PerDiemRate config don't retroactively
// affect already-submitted claims.
model PerDiemRequest {
  id                 String        @id @default(cuid())
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           User          @relation("EmployeePerDiem", fields: [employeeId], references: [id])
  supervisorId       String
  supervisor         User          @relation("SupervisorPerDiem", fields: [supervisorId], references: [id])
  destinationCountry String        // ISO-2: VN | ID | SA | …
  destinationCity    String?
  isHighCost         Boolean       @default(false)
  startDate          DateTime
  endDate            DateTime
  totalDays          Int
  // Currency the employee chose for the claim (display + payout).
  // USD is the canonical reporting currency, kept alongside.
  currency           String        @default("USD")
  // Rate captured at submission: 1 USD = N chosen-currency units.
  exchangeRate       Decimal       @default(1) @db.Decimal(15, 6)
  // Total in the chosen currency. Wide enough to fit 90 days × multi-million
  // IDR / VND amounts without overflow.
  totalAmount        Decimal       @db.Decimal(15, 2)
  // Total converted to USD — reporting reference, also used for cross-claim
  // overlap / budget checks where org-wide reporting standardises on USD.
  totalAmountUSD     Decimal       @db.Decimal(12, 2)
  status             PerDiemStatus @default(PENDING)
  reason             String?       @db.Text
  supervisorNote     String?       @db.Text
  rejectionReason    String?       @db.Text
  // Optional foreign-currency / international wire transfer details.
  // Per diem (uniquely among the reimbursement flows) lets the employee
  // route the payout to a specific bank account in a specific currency —
  // useful when they're traveling and need cash on the ground in the
  // local currency. All null = pay via the org's default flow in the
  // user's residence currency (defined by UserProfile.defaultCurrency,
  // falling back to Organization.baseCurrency).
  payoutCurrency       String?     // ISO-4217 if overriding
  payoutAccountHolder  String?
  payoutAccountNumber  String?     // IBAN / account number — free form
  payoutBankName       String?
  payoutBankAddress    String?     // required for many SWIFT wires
  payoutSwiftCode      String?     // SWIFT / BIC
  payoutRoutingNumber  String?     // ABA / sort code / IFSC — region-specific
  payoutNotes          String?     @db.Text
  // Optional category for the request as a whole — gives approvers a
  // quick read on the trip's purpose without parsing the reason text.
  category             String?     @default("BUSINESS_TRAVEL")
  approveToken       String?       @unique
  rejectToken        String?       @unique
  tokenExpiresAt     DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  days               PerDiemDay[]
  items              PerDiemItem[]

  @@index([organizationId, status])
  @@index([employeeId, status])
  @@index([supervisorId, status])
  @@index([employeeId, startDate, endDate])
}

// One row per calendar day inside the trip — backs the "Meal Deductions"
// grid in the UI. baseRateUSD is the rate at submission time; daily total
// is computed via src/lib/per-diem.ts and re-checked server-side on every
// write to avoid trusting the client.
model PerDiemDay {
  id                String          @id @default(cuid())
  requestId         String
  request           PerDiemRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  date              DateTime
  // Daily rate in the request's chosen currency (and USD reference).
  // Chosen-currency column is wide because IDR/VND rates run into the
  // millions per day; USD column stays tighter since USD daily rates
  // are bounded by policy in the low thousands.
  baseRate          Decimal         @db.Decimal(15, 2)
  baseRateUSD       Decimal         @db.Decimal(8, 2)
  // True for the first and last day of the trip → 75% multiplier on the
  // base before deductions (deductions still come off the FULL base).
  isTravelDay       Boolean         @default(false)
  breakfastProvided Boolean         @default(false)
  lunchProvided     Boolean         @default(false)
  dinnerProvided    Boolean         @default(false)
  // Daily totals — both currencies stored, dailyTotalUSD is the reference.
  // Same widening rationale as baseRate above.
  dailyTotal        Decimal         @db.Decimal(15, 2)
  dailyTotalUSD     Decimal         @db.Decimal(8, 2)
  // True when the employee manually set the day's amount instead of
  // accepting the calculated rate × scale × meal-deductions value.
  isOverride        Boolean         @default(false)

  @@unique([requestId, date])
  @@index([requestId])
}

// Itemized breakdown of a per-diem claim. Optional, descriptive — the
// request's totalAmount is still driven by the per-day grid above. These
// rows give the approver / finance a structured "what did this allowance
// cover" alongside the headline number, with an optional per-item amount
// for back-of-envelope sanity checking.
model PerDiemItem {
  id          String         @id @default(cuid())
  requestId   String
  request     PerDiemRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  // MEALS | LODGING | TRANSPORT | INCIDENTAL | COMMUNICATION | OTHER
  category    String         @default("OTHER")
  description String         @db.Text
  // Optional — when set, item is in the request's chosen currency.
  amount      Decimal?       @db.Decimal(15, 2)
  amountUSD   Decimal?       @db.Decimal(15, 2)
  // Optional — links the item to a specific trip day for context.
  date        DateTime?
  createdAt   DateTime       @default(now())

  @@index([requestId])
}

// ---------------------------------------------------------------------------
// Payroll
// ---------------------------------------------------------------------------

// Global library of payroll components, shared across all orgs. Country
// rules reference these by `code` so adding a country doesn't require
// duplicating the catalogue. Seeded with the standard set in
// scripts/seed-payroll-components.ts.
model PayrollComponent {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  // EARNING | STATUTORY_DEDUCTION | VOLUNTARY_DEDUCTION | EMPLOYER_CONTRIBUTION
  type        String
  // Whether this earning counts toward taxable income (false for non-taxable
  // allowances like de-minimis stipends). Ignored for non-EARNING types.
  isTaxable   Boolean @default(true)
  description String?
  createdAt   DateTime @default(now())

  countryRules CountryPayrollRule[]
}

// Per-org, per-country, per-component rule. Drives the calc engine: how
// to compute the line for this component when running payroll for a given
// employee in a given country.
model CountryPayrollRule {
  id              String  @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // ISO-3166-1 alpha-2. Org admins can scope rules per-country so a single
  // org running payroll across VN + ID + SA gets distinct configuration.
  countryCode     String
  // Optional regional cost center scoping. null = org-wide fallback rule
  // (applies to every employee unless overridden by a CC-specific rule).
  // The engine resolves rules by (orgId, employee.costCenterId) → falls
  // back to (orgId, null).
  costCenterId    String?
  costCenter      CostCenter? @relation("CostCenterPayrollRules", fields: [costCenterId], references: [id], onDelete: Cascade)
  componentId     String
  component       PayrollComponent @relation(fields: [componentId], references: [id])
  enabled         Boolean @default(true)
  // FIXED       — fixed amount in the country's currency
  // PERCENT_BASE  — percentage of base salary
  // PERCENT_GROSS — percentage of gross pay
  // BRACKET       — progressive tax brackets (see PayrollBracket)
  // FORMULA       — string formula evaluated by the engine
  calculationType String
  // Stored as Decimal so cents don't drift. Sense depends on calculationType:
  fixedAmount     Decimal? @db.Decimal(15, 2)
  // Percentage as decimal: 0.05 means 5%.
  percentage      Decimal? @db.Decimal(8, 6)
  // For FORMULA — variables: BASE, GROSS, TAXABLE, plus any other component
  // codes already computed. Evaluated by the engine sandbox.
  formula         String?
  // Optional caps applied after the calculation (e.g. SS contribution
  // capped at the per-month ceiling).
  minAmount       Decimal? @db.Decimal(15, 2)
  maxAmount       Decimal? @db.Decimal(15, 2)
  // Lower runs first. Earnings 0–99, statutory 100–199, voluntary 200–299
  // is the convention.
  sortOrder       Int @default(100)
  brackets        PayrollBracket[]
  updatedAt       DateTime @updatedAt
  updatedById     String?

  // costCenterId is part of the key — two cost centers in the same org
  // can define independent rules for the same component. nulls: NotDistinct
  // makes the NULL bucket act as a single row (Postgres ≥15) so an
  // org-wide fallback rule for a component is unique on its own.
  @@unique([organizationId, costCenterId, componentId], map: "CountryPayrollRule_org_cc_comp_key")
  @@index([organizationId, countryCode])
  @@index([organizationId, costCenterId])
}

// Progressive tax brackets attached to a CountryPayrollRule with
// calculationType = BRACKET. Rate is decimal (0.10 = 10%).
model PayrollBracket {
  id        String @id @default(cuid())
  ruleId    String
  rule      CountryPayrollRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  // Inclusive lower bound on taxable income.
  minAmount Decimal @db.Decimal(15, 2)
  // Exclusive upper bound on taxable income; null = unbounded (top bracket).
  maxAmount Decimal? @db.Decimal(15, 2)
  rate      Decimal @db.Decimal(5, 4)
  sortOrder Int

  @@index([ruleId, sortOrder])
}

// Per-employee compensation profile. The base salary feeds every
// percentage-based calculation; per-component overrides supplement
// or replace the country rule's defaults (e.g. a higher housing
// allowance for an executive).
model EmployeeCompensation {
  id                 String   @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Snapshot of the employee's cost center at the time the profile was
  // last written. Used by the engine to select per-CC rules without a
  // join through User on every calc.
  costCenterId       String?
  costCenter         CostCenter? @relation("CostCenterCompensations", fields: [costCenterId], references: [id], onDelete: SetNull)
  employeeId         String   @unique
  employee           User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  baseSalary         Decimal  @db.Decimal(15, 2)
  currency           String
  // Used for pro-rata: the count of working days the employee was paid
  // in a typical month (defaults to 22 — admin can override per employee).
  workingDaysPerMonth Int     @default(22)
  startedAt          DateTime
  endedAt            DateTime?
  // JSON map { COMPONENT_CODE: amount }. Amounts are in the employee's
  // currency. When set, this OVERRIDES the country rule's calculation
  // for that component; when absent, the country rule applies.
  componentOverrides Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([organizationId])
}

// One-off adjustments for a specific pay period (bonus, commission,
// unpaid-leave deduction, etc.). The calc engine adds these on top of
// the country-rule + override-driven baseline.
model PayrollAdjustment {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period         String   // YYYY-MM
  componentCode  String   // matches PayrollComponent.code
  // Positive = adds to gross / earnings, negative = deduction.
  amount         Decimal  @db.Decimal(15, 2)
  description    String?  @db.Text
  createdById    String
  createdAt      DateTime @default(now())

  @@index([organizationId, period])
  @@index([employeeId, period])
}

// Generated payslip for an employee + pay period. Headline figures are
// stored alongside the line breakdown so YTD totals are a fast Σ.
model Payslip {
  id               String   @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Snapshot of the employee's cost center at generate time. Survives a
  // later re-assignment so historical payslips stay attributed to the
  // region they were issued for.
  costCenterId     String?
  costCenter       CostCenter? @relation("CostCenterPayslips", fields: [costCenterId], references: [id], onDelete: SetNull)
  employeeId       String
  employee         User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period           String   // YYYY-MM
  countryCode      String
  currency         String
  // Pro-rata bookkeeping.
  workingDays      Int
  paidDays         Int
  // Headline numbers — frozen at finalize so subsequent rule changes
  // don't retroactively alter approved payslips.
  grossPay         Decimal  @db.Decimal(15, 2)
  taxableIncome    Decimal  @db.Decimal(15, 2)
  totalDeductions  Decimal  @db.Decimal(15, 2)
  netPay           Decimal  @db.Decimal(15, 2)
  // Employer-side contributions tracked separately so they don't roll
  // into net pay.
  employerCost     Decimal  @db.Decimal(15, 2) @default(0)
  // DRAFT | FINALIZED | PAID — DRAFT can be regenerated, the others are immutable.
  status           String   @default("DRAFT")
  generatedAt      DateTime @default(now())
  finalizedAt      DateTime?
  paidAt           DateTime?
  notes            String?  @db.Text
  lines            PayslipLine[]

  @@unique([employeeId, period])
  @@index([organizationId, period])
  @@index([organizationId, status])
}

model PayslipLine {
  id            String   @id @default(cuid())
  payslipId     String
  payslip       Payslip  @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  componentCode String
  componentName String
  // Mirrors PayrollComponent.type — duplicated so old payslips render
  // correctly even if the master component is renamed/retired.
  type          String
  amount        Decimal  @db.Decimal(15, 2)
  description   String?
  sortOrder     Int

  @@index([payslipId])
}
