// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  APPROVER
  FINANCE
  ADMIN
  SUPER_ADMIN
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CHANGE_REQUESTED
  PAID
}

enum Category {
  TRAVEL
  MEALS
  SUPPLIES
  ACCOMMODATION
  COMMUNICATION
  TRAINING
  ENTERTAINMENT
  MEETING
  EQUIPMENT
  PRINTING
  SOFTWARE
  OTHER
}

enum ApprovalStepStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGE_REQUESTED
}

enum ChangeRequestStatus {
  OPEN
  RESOLVED
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  IN_APP
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

// ---------------------------------------------------------------------------
// Leave & Calendar module enums
// ---------------------------------------------------------------------------

enum CalendarProvider {
  NONE
  GOOGLE
  LARK
  OUTLOOK
  APPLE_ICS
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  NEGOTIATING
}

enum ProposalStatus {
  PENDING
  AGREED
  DISAGREED
  SUPERSEDED
  EXPIRED
}

enum ProposerRole {
  SUPERVISOR
  EMPLOYEE
}

enum OvertimeDayType {
  WEEKDAY
  WEEKEND
  PUBLIC_HOLIDAY
}

enum OvertimeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WorkLocationType {
  OFFICE
  WFH
  WFS
}

enum PerDiemStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveEmailType {
  REQUEST_SUBMITTED
  APPROVED
  REJECTED
  SUPERVISOR_PROPOSAL
  EMPLOYEE_COUNTER
  PROPOSAL_AGREED
  PROPOSAL_DISAGREED
  REMINDER_PENDING
  REMINDER_LEAVE
  TOKEN_EXPIRED
  OVERTIME_REQUEST
  OVERTIME_APPROVED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  industry  String?
  logoUrl   String?
  baseCurrency String @default("IDR")
  countryCode String @default("ID")        // ISO-3166-1 alpha-2; drives default holidays
  createdAt DateTime @default(now())
  users     User[]
  invitations UserInvitation[]
  configs   AdminConfig[]
  leaveTypes      LeaveType[]
  leaveRequests   LeaveRequest[]
  publicHolidays  PublicHoliday[]
  overtimeRecords OvertimeRecord[]
  workLocationLogs WorkLocationLog[]
  leaveBalanceAdjustments LeaveBalanceAdjustment[]
  companyEvents   CompanyEvent[]
  perDiemRequests PerDiemRequest[]
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(EMPLOYEE)
  department    String?
  managerId     String?
  createdAt     DateTime  @default(now())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  status        UserStatus @default(PENDING)
  nationalIdUrl String?
  selfieUrl     String?
  kycVerified   Boolean    @default(false)
  notificationPrefs Json?
  invitations   UserInvitation[] @relation("InvitedBy")

  manager              User?                  @relation("ManagerSubordinates", fields: [managerId], references: [id])
  subordinates         User[]                 @relation("ManagerSubordinates")
  accounts             Account[]
  sessions             Session[]
  requests             ReimbursementRequest[] @relation("EmployeeRequests")
  approvalSteps        ApprovalStep[]
  changeRequestsRaised ChangeRequest[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  monthlyReports       MonthlyReport[]
  configUpdates        AdminConfig[]
  // Leave & calendar relations
  profile              UserProfile?
  calendarTokens       CalendarToken[]
  leaveRequests        LeaveRequest[]   @relation("EmployeeLeave")
  supervisedLeaves     LeaveRequest[]   @relation("SupervisorLeave")
  perDiemRequests      PerDiemRequest[] @relation("EmployeePerDiem")
  supervisedPerDiems   PerDiemRequest[] @relation("SupervisorPerDiem")
  leaveProposals       LeaveProposal[]
  overtimeRecords      OvertimeRecord[] @relation("EmployeeOT")
  supervisedOvertime   OvertimeRecord[] @relation("SupervisorOT")
  workLocationLogs     WorkLocationLog[]
  leaveBalanceAdjustments     LeaveBalanceAdjustment[] @relation("EmployeeAdj")
  leaveBalanceAdjustmentsMade LeaveBalanceAdjustment[] @relation("AdjGrantedBy")
}

model ReimbursementRequest {
  id          String        @id @default(cuid())
  employeeId  String
  title       String
  description String?       @db.Text
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("IDR")
  amountIDR   Decimal?      @db.Decimal(15, 2) // converted amount in Indonesian Rupiah
  exchangeRate Decimal?     @db.Decimal(15, 6) // FX rate used: 1 unit of currency = X IDR
  category    Category
  receiptUrl  String?
  receiptRaw  String?       @db.Text
  parsedData  Json?
  status      RequestStatus @default(DRAFT)
  submittedAt DateTime?
  month       String? // YYYY-MM
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  employee       User           @relation("EmployeeRequests", fields: [employeeId], references: [id])
  approvalSteps  ApprovalStep[]
  changeRequests ChangeRequest[]
  notifications  Notification[]
  auditLogs      AuditLog[]
}

model ApprovalStep {
  id         String             @id @default(cuid())
  requestId  String
  approverId String
  order      Int
  status     ApprovalStepStatus @default(PENDING)
  comment    String?            @db.Text
  decidedAt  DateTime?
  createdAt  DateTime           @default(now())

  request  ReimbursementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver User                 @relation(fields: [approverId], references: [id])
}

model ChangeRequest {
  id          String              @id @default(cuid())
  requestId   String
  raisedById  String
  raisedByRole Role
  message     String              @db.Text
  status      ChangeRequestStatus @default(OPEN)
  resolvedAt  DateTime?
  createdAt   DateTime            @default(now())

  request   ReimbursementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  raisedBy  User                 @relation(fields: [raisedById], references: [id])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  requestId String?
  type      String
  message   String              @db.Text
  read      Boolean             @default(false)
  channel   NotificationChannel @default(IN_APP)
  sentAt    DateTime            @default(now())

  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  request ReimbursementRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id        String   @id @default(cuid())
  requestId String?
  actorId   String
  action    String
  details   Json?
  createdAt DateTime @default(now())

  request ReimbursementRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  actor   User                  @relation(fields: [actorId], references: [id])
}

model AdminConfig {
  id             String   @id @default(cuid())
  key            String
  value          Json
  organizationId String?
  updatedAt      DateTime @updatedAt
  updatedById    String?

  updatedBy    User?         @relation(fields: [updatedById], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([key, organizationId])
}

model MonthlyReport {
  id            String   @id @default(cuid())
  month         String   @unique // YYYY-MM
  generatedById String
  sheetUrl      String?
  generatedAt   DateTime @default(now())

  generatedBy User @relation(fields: [generatedById], references: [id])
}

model UserInvitation {
  id          String       @id @default(cuid())
  email       String
  phone       String?
  role        Role         @default(EMPLOYEE)
  orgId       String?
  token       String       @unique @default(cuid())
  otp         String?
  otpExpiresAt DateTime?
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime
  sentAt      DateTime     @default(now())
  acceptedAt  DateTime?
  invitedById String
  invitedBy   User         @relation("InvitedBy", fields: [invitedById], references: [id])
  organization Organization? @relation(fields: [orgId], references: [id])
}

// ---------------------------------------------------------------------------
// User profile & onboarding
// ---------------------------------------------------------------------------

model UserProfile {
  id                  String           @id @default(cuid())
  userId              String           @unique
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  isOnboarded         Boolean          @default(false)
  countryCode         String           @default("ID")
  timezone            String           @default("Asia/Jakarta")
  defaultCurrency     String           @default("IDR")
  dateFormat          String           @default("DD/MM/YYYY")
  weekStartsOn        Int              @default(1)
  jobTitle            String?
  phone               String?
  photoUrl            String?
  calendarProvider    CalendarProvider @default(NONE)
  emailActionsEnabled Boolean          @default(true)
  notifyOnLeaveStatus Boolean          @default(true)
  notifyOnProposal    Boolean          @default(true)
  notifyBeforeLeave   String?          @default("1d")
  notifyInApp         Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model CalendarToken {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       CalendarProvider
  accountEmail   String?
  encryptedToken String           @db.Text
  tokenExpiry    DateTime?
  connectedAt    DateTime         @default(now())
  lastSyncedAt   DateTime?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, provider])
}

// ---------------------------------------------------------------------------
// Leave management
// ---------------------------------------------------------------------------

model LeaveType {
  id               String   @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code             String   // SICK | PERSONAL | FAMILY | ANNUAL | MATERNITY | PATERNITY | BEREAVEMENT | COMPENSATORY
  name             String
  description      String?
  colorHex         String   @default("#3B82F6")
  maxDaysPerYear   Int?
  requiresApproval Boolean  @default(true)
  isPaid           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  requests         LeaveRequest[]
  adjustments      LeaveBalanceAdjustment[]

  @@unique([organizationId, code])
}

model LeaveRequest {
  id                   String              @id @default(cuid())
  organizationId       String
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId           String
  employee             User                @relation("EmployeeLeave", fields: [employeeId], references: [id])
  supervisorId         String
  supervisor           User                @relation("SupervisorLeave", fields: [supervisorId], references: [id])
  leaveTypeId          String
  leaveType            LeaveType           @relation(fields: [leaveTypeId], references: [id])
  startDate            DateTime
  endDate              DateTime
  totalDays            Float
  isHalfDay            Boolean             @default(false)
  halfDayPeriod        String?             // "AM" | "PM"
  reason               String?             @db.Text
  status               LeaveStatus         @default(PENDING)
  supervisorNote       String?             @db.Text
  adminNote            String?             @db.Text
  rejectionReason      String?             @db.Text
  calEventEmployeeId   String?
  calEventSupervisorId String?
  approveToken         String?             @unique
  rejectToken          String?             @unique
  tokenExpiresAt       DateTime?
  negotiationRound     Int                 @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  proposals            LeaveProposal[]
  emailEvents          LeaveEmailEvent[]

  @@index([organizationId, status])
  @@index([employeeId, status])
  @@index([supervisorId, status])
}

model LeaveProposal {
  id              String           @id @default(cuid())
  leaveRequestId  String
  leaveRequest    LeaveRequest     @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  proposedById    String
  proposedBy      User             @relation(fields: [proposedById], references: [id])
  proposerRole    ProposerRole
  proposedStart   DateTime
  proposedEnd     DateTime
  proposedDays    Float
  message         String           @db.Text
  status          ProposalStatus   @default(PENDING)
  responseNote    String?          @db.Text
  agreeToken      String?          @unique
  disagreeToken   String?          @unique
  tokenExpiresAt  DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([leaveRequestId, status])
}

model LeaveEmailEvent {
  id             String         @id @default(cuid())
  leaveRequestId String
  leaveRequest   LeaveRequest   @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  toEmail        String
  toUserId       String?
  emailType      LeaveEmailType
  subject        String
  sentAt         DateTime       @default(now())
  tokenUsedAt    DateTime?
  actionTaken    String?        // "APPROVED" | "REJECTED" | "AGREED" | "DISAGREED" | "EXPIRED" | "SUPERSEDED"

  @@index([leaveRequestId, sentAt])
}

model PublicHoliday {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  date           DateTime
  countryCode    String
  isRecurring    Boolean  @default(true)
  type           String   @default("NATIONAL")
  createdAt      DateTime @default(now())

  @@unique([organizationId, date, countryCode, name])
  @@index([organizationId, date])
}

model OvertimeRecord {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       User            @relation("EmployeeOT", fields: [employeeId], references: [id])
  supervisorId   String
  supervisor     User            @relation("SupervisorOT", fields: [supervisorId], references: [id])
  date           DateTime
  hoursWorked    Float
  dayType        OvertimeDayType
  multiplier     Float
  lieuDaysEarned Float
  lieuExpiresAt  DateTime?
  calEventId     String?
  notes          String?         @db.Text
  status         OvertimeStatus  @default(PENDING)
  approveToken   String?         @unique
  rejectToken    String?         @unique
  tokenExpiresAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId, status])
  @@index([employeeId, date])
}

// Manual per-employee, per-leave-type, per-year balance adjustment.
// Positive `days` = extra allowance (e.g. mid-year hire prorated grant);
// negative = clawback. Summed in /api/leave/balance/[userId].
model LeaveBalanceAdjustment {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       User     @relation("EmployeeAdj", fields: [employeeId], references: [id])
  leaveTypeId    String
  leaveType      LeaveType @relation(fields: [leaveTypeId], references: [id])
  year           Int
  days           Float
  reason         String   @db.Text
  grantedById    String
  grantedBy      User     @relation("AdjGrantedBy", fields: [grantedById], references: [id])
  createdAt      DateTime @default(now())

  @@index([organizationId, employeeId, year])
  @@index([leaveTypeId, year])
}

// Org-scoped company / special events surfaced on the employee calendar.
// All-day or timed; can span multiple days. Admins CRUD via the admin
// console; everyone in the org can read.
model CompanyEvent {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  description    String?  @db.Text
  startDate      DateTime
  endDate        DateTime
  allDay         Boolean  @default(true)
  category       String   @default("COMPANY")  // COMPANY | SPECIAL | TRAINING | OTHER
  colorHex       String   @default("#22D3EE")
  location       String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, startDate])
}

model WorkLocationLog {
  id              String           @id @default(cuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        User             @relation(fields: [employeeId], references: [id])
  date            DateTime
  locationType    WorkLocationType
  locationName    String?
  locationAddress String?
  contactPhone    String?
  contactEmail    String?
  notes           String?          @db.Text
  calEventId      String?
  createdAt       DateTime         @default(now())

  @@index([organizationId, date])
  @@index([employeeId, date])
}

// ---------------------------------------------------------------------------
// Business Per Diem
// ---------------------------------------------------------------------------

// One claim per trip; rates and per-day breakdown are frozen at submission
// so subsequent admin changes to PerDiemRate config don't retroactively
// affect already-submitted claims.
model PerDiemRequest {
  id                 String        @id @default(cuid())
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           User          @relation("EmployeePerDiem", fields: [employeeId], references: [id])
  supervisorId       String
  supervisor         User          @relation("SupervisorPerDiem", fields: [supervisorId], references: [id])
  destinationCountry String        // ISO-2: VN | ID | SA | …
  destinationCity    String?
  isHighCost         Boolean       @default(false)
  startDate          DateTime
  endDate            DateTime
  totalDays          Int
  // Currency the employee chose for the claim (display + payout).
  // USD is the canonical reporting currency, kept alongside.
  currency           String        @default("USD")
  // Rate captured at submission: 1 USD = N chosen-currency units.
  exchangeRate       Decimal       @default(1) @db.Decimal(15, 6)
  // Total in the chosen currency.
  totalAmount        Decimal       @db.Decimal(12, 2)
  // Total converted to USD — reporting reference, also used for cross-claim
  // overlap / budget checks where org-wide reporting standardises on USD.
  totalAmountUSD     Decimal       @db.Decimal(12, 2)
  status             PerDiemStatus @default(PENDING)
  reason             String?       @db.Text
  supervisorNote     String?       @db.Text
  rejectionReason    String?       @db.Text
  approveToken       String?       @unique
  rejectToken        String?       @unique
  tokenExpiresAt     DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  days               PerDiemDay[]

  @@index([organizationId, status])
  @@index([employeeId, status])
  @@index([supervisorId, status])
  @@index([employeeId, startDate, endDate])
}

// One row per calendar day inside the trip — backs the "Meal Deductions"
// grid in the UI. baseRateUSD is the rate at submission time; daily total
// is computed via src/lib/per-diem.ts and re-checked server-side on every
// write to avoid trusting the client.
model PerDiemDay {
  id                String          @id @default(cuid())
  requestId         String
  request           PerDiemRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  date              DateTime
  // Daily rate in the request's chosen currency (and USD reference).
  baseRate          Decimal         @db.Decimal(8, 2)
  baseRateUSD       Decimal         @db.Decimal(8, 2)
  // True for the first and last day of the trip → 75% multiplier on the
  // base before deductions (deductions still come off the FULL base).
  isTravelDay       Boolean         @default(false)
  breakfastProvided Boolean         @default(false)
  lunchProvided     Boolean         @default(false)
  dinnerProvided    Boolean         @default(false)
  // Daily totals — both currencies stored, dailyTotalUSD is the reference.
  dailyTotal        Decimal         @db.Decimal(8, 2)
  dailyTotalUSD     Decimal         @db.Decimal(8, 2)
  // True when the employee manually set the day's amount instead of
  // accepting the calculated rate × scale × meal-deductions value.
  isOverride        Boolean         @default(false)

  @@unique([requestId, date])
  @@index([requestId])
}
